# =============================================================================
# KitchenOS client — environment variables
# =============================================================================
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
#
# Leave VITE_API_URL empty so the Vite proxy (dev) or same-origin /api (prod) is used.
#
# Production (cPanel same-origin):
#   1. Leave VITE_API_URL empty — the SPA calls /api/v1 on the same host
#   2. Build with: npm run build -w client
#   3. Serve via Express (SERVE_CLIENT=1) or copy client/dist to public_html
#
# Production (API on another host/subdomain):
#   Set VITE_API_URL to the HTTPS API origin (no trailing slash, no /api/v1)
#
# Media images are hosted on Cloudinary (absolute https URLs from the API).
# =============================================================================

# API origin only. No trailing slash. No /api/v1 suffix.
# Local / same-origin cPanel: leave empty
# Split host example: https://api.your-domain.com
VITE_API_URL=

# Idle session timeout (milliseconds)
# Tenant portal defaults
VITE_SESSION_IDLE_MS=180000
VITE_SESSION_WARNING_MS=30000
# Admin panel (5 minutes inactivity)
VITE_ADMIN_SESSION_IDLE_MS=300000
VITE_ADMIN_SESSION_WARNING_MS=30000

# Must match server PASSWORD_MIN_LENGTH (minimum 8)
VITE_PASSWORD_MIN_LENGTH=8
