# Copy to server/.env for local development / production

NODE_ENV="development"
# Local Docker Postgres (docker compose up -d postgres).
DATABASE_URL="postgresql://kitchenos:kitchenos@localhost:5432/kitchenos?schema=public&connection_limit=10&pool_timeout=20"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"
JWT_REMEMBER_EXPIRES_IN="30d"
PORT=4000
CLIENT_URL="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"
# Hours until approval activation links expire (default 24)
ACTIVATION_TOKEN_HOURS=24
# Production: absolute HTTPS API origin (same as CLIENT_URL for cPanel single-app)
# PUBLIC_API_URL="https://your-domain.com"
# Serve the Vite SPA from Express (recommended on cPanel when API + UI share one domain)
# SERVE_CLIENT="1"
# CLIENT_DIST_PATH="/home/USER/kitchenos/client/dist"
# Cloudinary (required in production)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: only used to serve legacy /uploads/... files during migration
UPLOAD_DIR="uploads"
# Local mail catcher: docker compose up -d mailpit → http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
# Optional: true|false. Defaults to true when port is 465, otherwise STARTTLS.
# SMTP_SECURE="false"
# Max wait for SMTP verify/send before failing the API request (ms).
# SMTP_TIMEOUT_MS="20000"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="KitchenOS <noreply@kitchenos.local>"
# Disable local pg_dump backups in production (default off):
# ENABLE_LOCAL_DB_BACKUP="false"
# Platform admins (required for seed). No hardcoded production emails.
ADMIN_EMAIL="admin@kitchenos.local"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="KitchenOS Admin"
STAFF_ADMIN_EMAIL="staff@kitchenos.local"
STAFF_ADMIN_PASSWORD="Staff@12345"
STAFF_ADMIN_NAME="KitchenOS Staff"
# Production seed only: ALLOW_PROD_SEED=1 (and never reset passwords unless intended)
# SEED_RESET_ADMIN_PASSWORDS=1
SUBSCRIPTION_ALERTS_INTERVAL_MINUTES=60
BACKUP_DIR="backups"
BACKUP_RETAIN_DAYS=14
BACKUP_INTERVAL_HOURS=24
# Minimum length for newly created/changed passwords (floor 8; raise e.g. to 12 later)
PASSWORD_MIN_LENGTH=8
# Optional token to expose GET /api/v1/health/cache in production (header: X-Health-Token)
# HEALTH_CACHE_TOKEN=
# Redis shared cache + rate limits. Recommended in production.
# On single-process cPanel without Redis: ALLOW_INMEMORY_CACHE=1
# REDIS_URL="redis://localhost:6379"
# ALLOW_INMEMORY_CACHE="1"
# cPanel Postgres without TLS (private network only):
# ALLOW_INSECURE_DB="1"
