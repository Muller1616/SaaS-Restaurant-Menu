# Copy values into cPanel → Setup Node.js App → Environment variables
# (or into server/.env on the host). Do not commit real secrets.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
# ALLOW_INSECURE_DB=1

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

CLIENT_URL=https://your-domain.com
PUBLIC_APP_URL=https://your-domain.com
PUBLIC_API_URL=https://your-domain.com

SERVE_CLIENT=1
# CLIENT_DIST_PATH=/home/USER/kitchenos/client/dist

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=mail.your-domain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@your-domain.com
SMTP_PASS=
SMTP_FROM=KitchenOS <noreply@your-domain.com>

ALLOW_INMEMORY_CACHE=1
# REDIS_URL=redis://default:password@host:6379

ENABLE_LOCAL_DB_BACKUP=false
PASSWORD_MIN_LENGTH=8
