# Production build template.
# Copy to `.env.production` before `vite build`.
#
# VITE_* values are baked into the JS bundle at build time.
#
# Same-origin cPanel (recommended): leave VITE_API_URL empty.
# Split host: set HTTPS API origin (no trailing slash, no /api/v1).

VITE_API_URL=

VITE_SESSION_IDLE_MS=180000
VITE_SESSION_WARNING_MS=30000
VITE_ADMIN_SESSION_IDLE_MS=300000
VITE_ADMIN_SESSION_WARNING_MS=30000

# Must match server PASSWORD_MIN_LENGTH
VITE_PASSWORD_MIN_LENGTH=8
